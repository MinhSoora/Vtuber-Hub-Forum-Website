PORT=3000
# Tai khoan Admin bang username/password. Bat buoc NEU khong dung Admin Discord (ADMIN_DISCORD_IDS o cuoi file)
ADMIN_USERNAME=admin
# Cach 1 (khuyen nghi): dung ADMIN_PASSWORD_HASH thay vi luu mat khau plaintext.
#   Tao bang: node scripts/hash-password.js "mat-khau-cua-ban"
#   Sau do XOA dong ADMIN_PASSWORD ben duoi va dan gia tri vao day.
ADMIN_PASSWORD_HASH=
# Cach 2 (don gian nhung kem an toan hon - mat khau nam plaintext trong file nay):
ADMIN_PASSWORD=doi-mat-khau-manh-o-day
# Nen dat (>=16 ky tu). Tao: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Chu ky auto refresh (ms), mac dinh 60000
REFRESH_INTERVAL_MS=60000
# Chi khi chay sau reverse proxy HTTPS (nginx/Cloudflare...): TRUST_PROXY=true
# COOKIE_SECURE=true chi khi chac chan chi truy cap qua HTTPS
# KHONG CAN bat ky API key nao.

# Fan art: API key imgbb (https://api.imgbb.com/) - bat buoc de upload anh
IMGBB_API_KEY=

# Cloudflare Turnstile (captcha khi dang Fan Art) - bat buoc de nguoi dung dang duoc anh.
# Tao widget tai https://dash.cloudflare.com/?to=/:account/turnstile
# Khi thu nghiem co the dung key test cua Cloudflare: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA (luon pass)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Dong gop / chinh sua noi dung (trang /contribute): tin nhan duoc gui ve kenh Discord qua webhook.
# Tao: Discord -> Cai dat kenh -> Tich hop -> Webhook -> Sao chep URL. Dung chung captcha Turnstile o tren.
DISCORD_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Dang nhap Discord (OAuth2) + tai khoan (/account). Chi lay id/username/avatar (scope "identify").
# 1) https://discord.com/developers/applications -> New Application -> OAuth2
# 2) Them Redirects: dung CHINH XAC gia tri DISCORD_REDIRECT_URI ben duoi (sai 1 ky tu la Discord tu choi)
# 3) Copy Client ID + Client Secret vao day. KHONG commit .env, KHONG chia se Client Secret.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Local: http://localhost:3000/auth/discord/callback   |   Production: https://ten-mien-cua-ban/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
# Discord ID cua cac Admin, cach nhau bang dau phay. Lay ID: Discord -> Cai dat -> Nang cao -> bat Che do nha phat trien
# -> chuot phai vao ten minh -> Sao chep ID. Vi du: ADMIN_DISCORD_IDS=123456789012345678,234567890123456789
ADMIN_DISCORD_IDS=
# (Tuy chon) File luu tru; mac dinh nam trong data/ (da co trong .gitignore)
# USERS_FILE=./data/users.json
# SESSIONS_FILE=./data/sessions.json
# Neu dung Discord login: BAT BUOC dat SESSION_SECRET o tren (>=16 ky tu), va khi chay HTTPS thi COOKIE_SECURE=true (+ TRUST_PROXY=true neu sau proxy)
# Khi da co ADMIN_DISCORD_IDS + Discord OAuth, co the BO ADMIN_USERNAME/ADMIN_PASSWORD de tat hoan toan dang nhap admin bang mat khau.
# (Tuy chon) File luu Forum / Fan Art; mac dinh trong data/ (posts.json, comments.json, fanarts.json - da co trong .gitignore).
# Fan Art tu doc data/fanart.json cu neu chua co fanarts.json (khong mat du lieu).
# POSTS_FILE=./data/posts.json
# COMMENTS_FILE=./data/comments.json
# FANART_FILE=./data/fanarts.json
# Forum / Fan Art can IMGBB_API_KEY (upload anh) va dang nhap Discord (DISCORD_*). Turnstile gio la TUY CHON (lop bo sung).

# ---------------------------------------------------------------------------
# Admin Dashboard nang cap: Users / Moderation / Popup / Marquee (tat ca tuy chon)
# File luu (mac dinh trong data/, da co trong .gitignore): moderation.json, popups.json, marquee.json
# MODERATION_FILE=./data/moderation.json
# POPUPS_FILE=./data/popups.json
# MARQUEE_FILE=./data/marquee.json
# Gioi han thao tac nhay cam cua Admin (ban/kick/warn, tao/sua/xoa thong bao) moi phut / tai khoan. Mac dinh 30.
# ADMIN_RATE_MAX=30

# ---------------------------------------------------------------------------
# Chong spam Feed / Fan Art
# Bai viet MOI, binh luan MOI, Fan Art (dang + sua) di kem Cloudflare Turnstile khi da dat TURNSTILE_SITE_KEY + TURNSTILE_SECRET_KEY (o tren).
# Widget o che do "interaction-only": thuong chay ngam, chi hien khi Cloudflare nghi ngo.
# CAPTCHA_REQUIRED=true: neu chua cau hinh Turnstile thi CHAN dang bai/binh luan/Fan Art (fail-closed). Khuyen nghi bat khi chay that.
# CAPTCHA_REQUIRED=true
# Chay sau Cloudflare (proxy da bat): dat de rate limit dung IP that cua nguoi dung (lay tu CF-Connecting-IP).
# CHI bat khi server chi nhan traffic qua Cloudflare, neu khong header nay co the bi gia mao.
# TRUST_CLOUDFLARE=true
# (Tuy chon) Nhan he so cho MOI gioi han rate limit, mac dinh 1. Vd 2 = noi long gap doi luc cao diem.
# RATE_LIMIT_SCALE=1
